{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Nutts5796/logiparity/v1.2.0/docs/report-schema.json",
  "title": "LogiParity parity report, schemaVersion 1",
  "type": "object",
  "required": ["schemaVersion", "entities", "findings"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "patterns": {
      "type": "object",
      "properties": {
        "minCount": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["explained", "needsReview"],
      "properties": {
        "explained": {
          "type": "integer",
          "minimum": 0
        },
        "needsReview": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "reference", "counts"],
        "properties": {
          "entity": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "pluralLabel": {
            "type": "string"
          },
          "aggregates": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/aggregate"
            }
          },
          "uniqueCounts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "rollupSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "object"
                },
                "rollup": {
                  "type": "object"
                },
                "caseSensitive": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "entity", "source", "key", "field", "message"],
        "properties": {
          "type": {
            "enum": [
              "missing_in_source",
              "extra_in_source",
              "field_mismatch",
              "aggregate_mismatch",
              "duplicate_key",
              "duplicate_value",
              "invalid_value",
              "source_error"
            ]
          },
          "entity": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "row": {
            "type": "integer",
            "minimum": 1
          },
          "keyParts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "expected": {
            "$ref": "#/definitions/scalar"
          },
          "actual": {
            "$ref": "#/definitions/scalar"
          },
          "blocking": {
            "type": "boolean"
          },
          "referencePosition": {
            "type": "integer",
            "minimum": 1
          },
          "relatedKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hint": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          },
          "accounting": {
            "type": "object",
            "required": ["causes", "remainder"],
            "properties": {
              "causes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remainder": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          },
          "amounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "amount"],
              "properties": {
                "field": {
                  "type": "string"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "amount": {
                  "$ref": "#/definitions/integerAmount"
                }
              }
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["row", "value"],
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "value": {
                  "$ref": "#/definitions/scalar"
                }
              }
            }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "offsetFree": {
                "type": "boolean"
              },
              "paginated": {
                "type": "boolean"
              },
              "pageSizes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "timezone": {
                "type": "string"
              },
              "referenceInvalid": {
                "type": "boolean"
              },
              "referenceUncertain": {
                "type": "boolean"
              },
              "referenceValue": {
                "$ref": "#/definitions/scalar"
              },
              "sourceContainsReference": {
                "type": "boolean"
              },
              "referenceCount": {
                "type": "integer",
                "minimum": 0
              },
              "matchingCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "source", "field", "kind", "count", "summary"],
        "properties": {
          "entity": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "datetime_offset",
              "money_delta",
              "value_mapping",
              "missing_stride",
              "extra_stride",
              "formatting_difference",
              "number_change"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 3
          },
          "findingIndexes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "cause": {
            "type": "string"
          },
          "stride": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delta": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "expected": {
            "$ref": "#/definitions/scalar"
          },
          "actual": {
            "$ref": "#/definitions/scalar"
          },
          "referenceCount": {
            "type": "integer",
            "minimum": 0
          },
          "matchingCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          }
        }
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "definitions": {
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "aggregate": {
      "type": "object",
      "required": ["name", "type", "values", "skippedSources"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": ["sum", "count"]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "skippedSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valuesByCurrency": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/reconciliation"
          }
        },
        "rawValues": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "rawValuesByCurrency": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        "uncertainKeys": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/keyParts"
          }
        },
        "excludedRows": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "sourceStatus": {
          "type": "object",
          "additionalProperties": {
            "enum": ["certain", "uncertain", "not_mapped", "not_read"]
          }
        },
        "reconciliationByCurrency": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/reconciliation"
            }
          }
        },
        "exactValues": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          }
        }
      }
    },
    "integerAmount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        {
          "type": "integer"
        }
      ]
    },
    "keyParts": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "rowContribution": {
      "type": "object",
      "required": ["count", "amount"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "amount": {
          "$ref": "#/definitions/decimalAmount"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "required": ["missingRows", "patterns", "remainder"],
      "properties": {
        "missingRows": {
          "$ref": "#/definitions/rowContribution"
        },
        "extraRows": {
          "$ref": "#/definitions/rowContribution"
        },
        "valueDifferences": {
          "$ref": "#/definitions/rowContribution"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "count", "amount"],
            "properties": {
              "group": {
                "type": "integer",
                "minimum": 0
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "amount": {
                "$ref": "#/definitions/decimalAmount"
              }
            }
          }
        },
        "remainder": {
          "$ref": "#/definitions/decimalAmount"
        },
        "uncertain": {
          "type": "object",
          "required": ["keys", "amount"],
          "properties": {
            "keys": {
              "$ref": "#/definitions/keyParts"
            },
            "amount": {
              "$ref": "#/definitions/decimalAmount"
            }
          }
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decimalAmount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        {
          "type": "integer"
        }
      ]
    }
  }
}
