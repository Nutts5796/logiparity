{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Nutts5796/logiparity/v1.1.0/docs/scenario-report-schema.json",
  "title": "LogiParity scenario report, schemaVersion 1",
  "type": "object",
  "required": ["schemaVersion", "kind", "name", "target", "environment", "events", "invariants", "exitCode"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "scenario"
    },
    "name": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "environment": {
      "enum": ["test", "staging"]
    },
    "exitCode": {
      "enum": [0, 1, 2]
    },
    "synthetic": {
      "type": "boolean"
    },
    "sourceLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "affectedOrderCount": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "parity": {
      "$ref": "https://raw.githubusercontent.com/Nutts5796/logiparity/v1.1.0/docs/report-schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "type", "completed"],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "affectedKeys", "explanation"],
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "affectedKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string"
          },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "before", "after"],
              "properties": {
                "key": {
                  "type": "string"
                },
                "before": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
