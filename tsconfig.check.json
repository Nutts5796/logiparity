{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@logiparity/core": [
        "packages/core/src/index.ts"
      ],
      "@logiparity/adapters": [
        "packages/adapters/src/index.ts"
      ],
      "@logiparity/scenarios": [
        "packages/scenarios/src/index.ts"
      ],
      "@logiparity/ai": [
        "packages/ai/src/index.ts"
      ],
      "@logiparity/demo-delivery": [
        "apps/demo-delivery/src/start.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest*.ts"
  ]
}
