{
  "name": "logiparity",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "author": "Sergei Orekhovskii",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/adapters packages/scenarios packages/ai packages/cli apps/demo-delivery",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "demo": "npm run build && node apps/demo-delivery/dist/main.js",
    "demo:bugs": "npm run build && node apps/demo-delivery/dist/main.js --bugs",
    "demo:export": "node scripts/export-demo.mjs",
    "demo:login": "node scripts/login-demo.mjs",
    "check:demo": "npm run build && node packages/cli/dist/main.js check --config examples/demo/parity.yaml",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:quickstart": "node scripts/check-quickstart.mjs",
    "test:docker": "node scripts/check-docker.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "release:prepare": "npm run build && node scripts/prepare-release.mjs",
    "check:third-party": "node scripts/check-third-party.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/luxon": "3.7.2",
    "@types/node": "20.19.37",
    "@types/pg": "8.23.1",
    "@types/unzipper": "0.10.11",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "playwright": "1.64.1",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1",
    "exceljs": "4.4.0",
    "saxes": "6.0.0",
    "jszip": "3.10.1"
  },
  "description": "Test/staging logistics data parity and disruption scenario checks, with optional AI drafts.",
  "bin": {
    "logiparity": "bin/logiparity.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/",
    "templates/",
    "examples/ai/",
    "examples/postgres/",
    "examples/demo/*.yaml",
    "examples/demo/fixtures/",
    "examples/demo/scenarios/",
    "api/",
    "examples/staging/",
    "examples/freight/"
  ],
  "dependencies": {
    "@logiparity/cli": "1.0.1",
    "@logiparity/core": "1.0.1",
    "@logiparity/adapters": "1.0.1",
    "@logiparity/scenarios": "1.0.1",
    "@logiparity/ai": "1.0.1"
  },
  "bundleDependencies": true,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logistics",
    "testing",
    "data-parity",
    "qa",
    "scenarios"
  ],
  "exports": {
    "./core": {
      "types": "./api/core.d.ts",
      "import": "./api/core.js"
    },
    "./adapters": {
      "types": "./api/adapters.d.ts",
      "import": "./api/adapters.js"
    },
    "./scenarios": {
      "types": "./api/scenarios.d.ts",
      "import": "./api/scenarios.js"
    },
    "./ai": {
      "types": "./api/ai.d.ts",
      "import": "./api/ai.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nutts5796/logiparity.git"
  },
  "homepage": "https://github.com/Nutts5796/logiparity#readme",
  "bugs": {
    "url": "https://github.com/Nutts5796/logiparity/issues"
  }
}
