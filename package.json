{
  "name": "logiparity",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Sergei Orekhovskii",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/adapters packages/scenarios packages/ai packages/cli apps/demo-delivery",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "demo": "npm run build && node apps/demo-delivery/dist/main.js",
    "demo:bugs": "npm run build && node apps/demo-delivery/dist/main.js --bugs",
    "demo:export": "node scripts/export-demo.mjs",
    "demo:login": "node scripts/login-demo.mjs",
    "check:demo": "npm run build && node packages/cli/dist/main.js check --config examples/demo/parity.yaml",
    "prepack": "node scripts/prepack.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:quickstart": "node scripts/check-quickstart.mjs",
    "test:docker": "node scripts/check-docker.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "release:prepare": "npm run build && node scripts/prepare-release.mjs",
    "check:third-party": "node scripts/check-third-party.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:bump": "node scripts/bump-version.mjs",
    "pack:artifact": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/luxon": "3.7.2",
    "@types/node": "20.19.37",
    "@types/pg": "8.23.1",
    "@types/unzipper": "0.10.11",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "saxes": "6.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1",
    "pg-query-stream": "4.17.1",
    "pgsql-ast-parser": "12.0.2",
    "ajv": "6.15.0"
  },
  "description": "Test/staging logistics data parity and disruption scenario checks.",
  "bin": {
    "logiparity": "bin/logiparity.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/*.md",
    "templates/",
    "examples/ai/",
    "examples/postgres/",
    "examples/demo/*.yaml",
    "examples/demo/fixtures/",
    "examples/demo/scenarios/",
    "api/",
    "examples/staging/",
    "THIRD_PARTY_LICENSES.txt",
    "examples/freight/*.csv",
    "examples/freight/*.yaml",
    "examples/freight/README.md",
    "docs/*.json"
  ],
  "dependencies": {
    "@logiparity/adapters": "1.1.0",
    "@logiparity/ai": "1.1.0",
    "@logiparity/cli": "1.1.0",
    "@logiparity/core": "1.1.0",
    "@logiparity/scenarios": "1.1.0",
    "@logiparity/demo-delivery": "1.1.0",
    "luxon": "3.7.2",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "csv-parse": "7.0.3",
    "unzipper": "0.12.5",
    "saxes": "6.0.0",
    "jiti": "2.7.0"
  },
  "bundleDependencies": [
    "@logiparity/cli",
    "@logiparity/core",
    "@logiparity/adapters",
    "@logiparity/scenarios",
    "@logiparity/ai",
    "@logiparity/demo-delivery"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logistics",
    "testing",
    "data-parity",
    "qa",
    "scenarios"
  ],
  "exports": {
    "./core": {
      "types": "./api/core.d.ts",
      "import": "./api/core.js"
    },
    "./adapters": {
      "types": "./api/adapters.d.ts",
      "import": "./api/adapters.js"
    },
    "./scenarios": {
      "types": "./api/scenarios.d.ts",
      "import": "./api/scenarios.js"
    },
    "./ai": {
      "types": "./api/ai.d.ts",
      "import": "./api/ai.js"
    },
    "./report-schema.json": "./docs/report-schema.json",
    "./scenario-report-schema.json": "./docs/scenario-report-schema.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nutts5796/logiparity.git"
  },
  "homepage": "https://github.com/Nutts5796/logiparity#readme",
  "bugs": {
    "url": "https://github.com/Nutts5796/logiparity/issues"
  },
  "peerDependencies": {
    "playwright": ">=1.63.0 <2.0.0",
    "pg": ">=8.16.0 <9.0.0",
    "pg-query-stream": ">=4.17.1 <5.0.0",
    "pgsql-ast-parser": ">=12.0.2 <13.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    },
    "pgsql-ast-parser": {
      "optional": true
    }
  }
}
